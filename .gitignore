# Build artifacts
/bin/
/dist/
# 'go build .' without -o drops a binary in the repo root; the
# canonical output target is /bin/ (Makefile) or /dist/ (release).
/spotter
# Ignore every build/ entry by default, but keep the macOS bundle
# metadata + icon under source control (Info.plist is templated by
# 'wails build'; iconfile.icns is generated from build/appicon.png and
# embedded into Spotter.app's Contents/Resources).
/build/*
!/build/appicon.png
!/build/darwin/
!/build/darwin/Info.plist
!/build/darwin/iconfile.icns
/build/bin/
*.exe
*.test
*.out
*.syso

# Wails
/build/bin/
/frontend/dist/
/frontend/wailsjs/
# TypeScript / Vite build artefacts produced by `wails build` next to
# the user's sources. None of these are needed at runtime; they only
# show up because tsc and Vite emit them in the project root.
/frontend/*.md5
/frontend/*.tsbuildinfo
/frontend/vite.config.d.ts
/frontend/vite.config.js
# tsc-on-demand output for `node --test scripts/run-tests.mjs`
# (alerts.test infra). Regenerated on each test run; never commit.
/frontend/.test-build/

# IDE
.vscode/
.idea/
.cursor/
.claude/
*.swp

# OS
.DS_Store
Thumbs.db