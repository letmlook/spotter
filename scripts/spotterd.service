[Unit]
Description=Spotter Device Discovery Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/spotterd --config /etc/spotterd/agent.toml
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
# Hardening: spotterd is a privileged control plane (it must call
# `systemctl reboot/poweroff` on its own machine), so the two flags
# that block suid/syscalls must be DISABLED — otherwise the child
# systemctl process inherits the ProtectedSystem namespace and
# silently fails to reach PID 1. We keep ProtectHome + PrivateTmp
# which don't interfere with power actions.
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target